{
  "name": "kindcipe-backend",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "simulate:chef": "tsx server/scripts/simulateChef.ts",
    "dev": "tsx server/index.ts",
    "dev:watch": "tsx watch server/index.ts",
    "build": "tsc --noEmit && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "check:i18n-coverage": "node scripts/check-i18n-coverage.cjs",
    "check:en": "tsx scripts/check-en-coverage.ts",
    "backfill:translations": "tsx scripts/backfill-recipe-translations.ts",
    "backfill:ingredient-l10n": "tsx scripts/backfill-ingredient-l10n.ts",
    "promote:admin": "tsx scripts/promote-admin.ts",
    "promo:codes": "tsx scripts/promo-codes.ts",
    "test:billing": "tsx --test server/services/billingRules.test.ts",
    "test:chef": "tsx --test server/services/chefIntent.test.ts server/services/recipeSetAssembler.test.ts server/services/aiChefPolicy.test.ts server/services/chatQuota.test.ts server/services/chefFaq.test.ts server/services/chefDispatcher.test.ts server/services/chefDialogues.test.ts server/services/chefPlanner.test.ts server/services/chefQueryPlan.test.ts server/services/chefSafety.test.ts server/services/llmCost.test.ts server/services/chefResponse.test.ts server/services/aiChefIdempotency.test.ts server/services/aiChefLifecycle.test.ts server/services/aiChefRouting.test.ts server/services/aiChefFlagOff.test.ts server/services/aiChefFinalization.test.ts server/services/aiChefFlagMatrix.test.ts server/routers/facebookImport.test.ts server/routers/importNormalize.test.ts",
    "test:chef:db": "tsx --test server/services/aiChefBugSpec.test.ts server/routers/aiRecipeRouter.test.ts server/services/llmCostStale.test.ts",
    "report:llm-cost": "tsx scripts/report-llm-cost.ts",
    "probe:fb": "tsx scripts/probe-fb.ts",
    "preflight": "bash scripts/preflight-railway.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.693.0",
    "@aws-sdk/s3-request-presigner": "^3.693.0",
    "@sentry/node": "11.4.0",
    "@trpc/server": "^11.6.0",
    "axios": "^1.12.0",
    "bcryptjs": "^2.4.3",
    "cookie": "^1.0.2",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.5",
    "expo-server-sdk": "^3.10.0",
    "express": "^4.21.2",
    "express-rate-limit": "8.7.0",
    "google-auth-library": "^10.7.0",
    "jose": "6.1.0",
    "nanoid": "^5.1.5",
    "postgres": "^3.4.5",
    "sharp": "^0.35.3",
    "stripe": "22.6.2",
    "superjson": "^1.13.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "^24.7.0",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.1",
    "typescript": "5.9.3"
  }
}
