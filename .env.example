# ─── Required ────────────────────────────────────────────────────────────────

# Supabase PostgreSQL connection string
# Get from: Supabase Dashboard → Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# JWT secret for session cookies (generate a random 32+ char string)
# Generate: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-here

# ─── Google OAuth (Social Login) ─────────────────────────────────────────────

# Google OAuth Web Client ID
# Get from: Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=690207937492-7hfs5hkksd5heo78kcfmq294f19rgp6d.apps.googleusercontent.com

# Google OAuth Web Client Secret
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Cloudflare R2 Storage ────────────────────────────────────────────────────

# Get from: Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=kindcipe-storage
# Public URL (if bucket is public): https://pub-xxx.r2.dev
R2_PUBLIC_URL=

# ─── Alibaba Cloud DashScope (Qwen LLM) ──────────────────────────────────────

# Get DashScope API Key from: https://modelstudio.console.alibabacloud.com → API Key
# Singapore endpoint: https://ws-{workspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# International default: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# ─── Optional ─────────────────────────────────────────────────────────────────

# Allowed CORS origins (comma-separated, leave empty to allow all)
# Web app origins must be listed explicitly (browsers send an Origin header):
#   ALLOWED_ORIGINS=https://kindcipe.com,https://app.kindcipe.com
ALLOWED_ORIGINS=

# Session cookie domain (web app). Leave empty for native-only / localhost.
# Set to ".kindcipe.com" so api.kindcipe.com's cookie is shared with
# app.kindcipe.com and kindcipe.com.
COOKIE_DOMAIN=

# YouTube API Key (for recipe import from YouTube)
YOUTUBE_API_KEY=

# RapidAPI Key (for price checking)
RAPIDAPI_KEY=

# Resend API Key (for password reset emails)
RESEND_API_KEY=

# Default sender for reset emails
RESEND_FROM_EMAIL=Kindcipe <onboarding@resend.dev>

# App ID (optional, defaults to "kindcipe")
APP_ID=kindcipe

# Beta: treat all households as Pro (unset before public launch)
BETA_ALL_PAID=true

# Sign in with Apple — Web/Android OAuth (Services ID + .p8 key)
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_SERVICES_ID=
APPLE_PRIVATE_KEY=
APPLE_WEB_REDIRECT_URI=

# ─── Stripe (Web/Android subscription billing) ───────────────────────────────
# Dashboard → Developers → API keys (use test keys first)
STRIPE_SECRET_KEY=
# Dashboard → Developers → Webhooks → signing secret for /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Products → recurring prices (HK$30/mo, HK$288/yr)
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Where the browser returns after checkout (must be in ALLOWED_ORIGINS)
STRIPE_SUCCESS_URL=https://app.kindcipe.com/settings?billing=success
STRIPE_CANCEL_URL=https://app.kindcipe.com/settings?billing=cancel
